# RecoveryOS environment configuration (canonical reference)
#
# Copy this file to the locations below, then adjust values as needed:
#   cp .env.example apps/api/.env          (API server)
#   cp .env.example apps/web/.env.local    (Next.js dashboard)
#
# `npm run setup` performs both copies automatically.
#
# NEVER commit real .env files, credentials, API keys or tokens.

# ---------------------------------------------------------------------------
# Shared
# ---------------------------------------------------------------------------

# Node runtime environment for the API process.
# One of: development | test | production
NODE_ENV=development

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

# PostgreSQL connection string used by Prisma.
# The password below is a LOCAL DEVELOPMENT credential only. Never use it in
# any shared or production environment.
DATABASE_URL=postgresql://recoveryos:recoveryos_dev@localhost:5432/recoveryos?schema=public

# ---------------------------------------------------------------------------
# API (apps/api)
# ---------------------------------------------------------------------------

# Host/interface the API binds to.
API_HOST=0.0.0.0

# Port the API listens on.
API_PORT=4000

# Log verbosity for the API process.
# One of: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Web dashboard (apps/web) -- values must be prefixed with NEXT_PUBLIC_ to be
# exposed to the browser bundle.
# ---------------------------------------------------------------------------

# Public URL where the dashboard is served.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Base URL of the RecoveryOS API, used by server components to call /health.
NEXT_PUBLIC_API_URL=http://127.0.0.1:4000
