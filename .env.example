# RecoveryOS environment configuration (canonical reference)
#
# Copy this file to the locations below, then adjust values as needed:
#   cp .env.example apps/api/.env          (API server)
#   cp .env.example apps/web/.env.local    (Next.js dashboard)
#
# `npm run setup` performs both copies automatically.
#
# NEVER commit real .env files, credentials, API keys or tokens.

# ---------------------------------------------------------------------------
# Shared
# ---------------------------------------------------------------------------

# Node runtime environment for the API process.
# One of: development | test | production
NODE_ENV=development

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

# PostgreSQL connection string used by Prisma.
# The password below is a LOCAL DEVELOPMENT credential only. Never use it in
# any shared or production environment.
DATABASE_URL=postgresql://recoveryos:recoveryos_dev@localhost:5432/recoveryos?schema=public

# ---------------------------------------------------------------------------
# API (apps/api)
# ---------------------------------------------------------------------------

# Host/interface the API binds to.
API_HOST=0.0.0.0

# Port the API listens on.
API_PORT=4000

# Log verbosity for the API process.
# One of: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Razorpay webhook secret for signature verification.
# Used to verify X-Razorpay-Signature via HMAC-SHA256.
# NEVER commit a real secret. Set this in apps/api/.env for local development.
RAZORPAY_WEBHOOK_SECRET=whsec_test_placeholder_replace_me

# Payment account ID used for test-mode webhook event resolution.
# In production this is resolved from authenticated merchant connections.
# For local development, create a PaymentAccount in the database and set its UUID here.
DEFAULT_TEST_PAYMENT_ACCOUNT_ID=

# Correlation window (in hours) used by the detection engine when deciding
# whether a failed payment was later recovered or an authorization expired.
# Accepts 1-720; defaults to 24 when unset.
DETECTION_WINDOW_HOURS=24

# ---------------------------------------------------------------------------
# AI Recovery Intelligence (Phase 5) -- advisory layer ONLY.
# AI can never override deterministic safety decisions; every failure mode
# degrades to "AI unavailable" while decisions keep working. Disabled by default.
# ---------------------------------------------------------------------------

AI_ENABLED=false

# Informational provider label persisted with advice (e.g. openai-compatible).
AI_PROVIDER=

# OpenAI-compatible chat-completions configuration. Works with hosted
# gateways or local OpenAI-compatible servers. Placeholders only — never
# commit real keys.
AI_MODEL=
AI_API_KEY=
AI_BASE_URL=

# Hard timeout for advisor calls (250-60000 ms).
AI_TIMEOUT_MS=5000

# Version stamp persisted with every advice row for auditability.
AI_ADVISOR_VERSION=v1

# ---------------------------------------------------------------------------
# Controlled Recovery Execution (Phase 6) -- DISABLED by default.
# Only RETRY is ever executable, only through the deterministic safety gate,
# and provider acceptance is NOT payment recovery (payment events confirm it).
# ---------------------------------------------------------------------------

RECOVERY_EXECUTION_ENABLED=false

# Safety-gate tuning: minimum decision confidence and maximum retry attempts
# per opportunity before the gate blocks further execution.
RECOVERY_EXECUTION_MIN_CONFIDENCE=60
RECOVERY_EXECUTION_MAX_RETRIES=3

# Provider + gateway endpoint for retry submission. Razorpay's public API has
# no direct merchant-initiated payment-retry endpoint; the adapter targets an
# explicitly configured gateway URL. When unset, execution requests return a
# deterministic "not_configured" unavailability instead of pretending success.
# Placeholders only -- never commit real keys.
RECOVERY_EXECUTION_PROVIDER=razorpay
RECOVERY_EXECUTION_API_URL=
RECOVERY_EXECUTION_API_KEY=
RECOVERY_EXECUTION_TIMEOUT_MS=5000

# ---------------------------------------------------------------------------
# Recovery Operations & Automation (Phase 7) -- DISABLED by default.
# The in-process scheduler reuses the Phase 6 execution pipeline and safety
# gate; it can later be replaced by an external job queue invoking tick().
# ---------------------------------------------------------------------------

RECOVERY_AUTOMATION_ENABLED=false

# Scheduler cadence (5-3600 seconds).
RECOVERY_AUTOMATION_TICK_SECONDS=30

# Bounded automated attempts per opportunity.
RECOVERY_MAX_ATTEMPTS=3

# PENDING executions older than this are deterministically CANCELLED (1-8760h).
RECOVERY_OPERATION_MAX_AGE_HOURS=72

# Deterministic exponential backoff base between automated attempts (1-86400s).
RECOVERY_RETRY_BACKOFF_SECONDS=300

# ---------------------------------------------------------------------------
# Web dashboard (apps/web) -- values must be prefixed with NEXT_PUBLIC_ to be
# exposed to the browser bundle.
# ---------------------------------------------------------------------------

# Public URL where the dashboard is served.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Base URL of the RecoveryOS API, used by server components to call /health.
NEXT_PUBLIC_API_URL=http://127.0.0.1:4000
