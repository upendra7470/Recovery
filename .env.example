# ── RecoveryOS Environment Configuration ──────────────────────────────────────
# Copy to .env and fill in values. All fields have sensible defaults for local dev.

# ── Core ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
DATABASE_URL=postgresql://recoveryos:recoveryos_dev@localhost:5432/recoveryos?schema=public
LOG_LEVEL=info

# ── Authentication (Phase 8) ──────────────────────────────────────────────────
# AUTH_ENABLED=false
# AUTH_SESSION_SECRET=               # Min 32 chars, required when AUTH_ENABLED=true
# AUTH_SESSION_TTL_HOURS=24
# AUTH_COOKIE_SECURE=true
# AUTH_ALLOWED_WEB_ORIGIN=

# ── AI Recovery Intelligence (Phase 5) ────────────────────────────────────────
# AI_ENABLED=false
# AI_PROVIDER=
# AI_MODEL=
# AI_API_KEY=                        # Min 8 characters
# AI_BASE_URL=
# AI_TIMEOUT_MS=5000
# AI_ADVISOR_VERSION=v1

# ── Recovery Execution (Phase 6) ──────────────────────────────────────────────
# RECOVERY_EXECUTION_ENABLED=false
# RECOVERY_EXECUTION_MIN_CONFIDENCE=60
# RECOVERY_EXECUTION_MAX_RETRIES=3
# RECOVERY_EXECUTION_TIMEOUT_MS=5000
# RECOVERY_EXECUTION_PROVIDER=      # Only "razorpay" supported
# RAZORPAY_KEY_ID=                   # Required when provider=razorpay
# RAZORPAY_KEY_SECRET=               # Required when provider=razorpay, NEVER logged
# RAZORPAY_BASE_URL=

# ── Recovery Automation (Phase 7) ─────────────────────────────────────────────
# RECOVERY_AUTOMATION_ENABLED=false
# RECOVERY_AUTOMATION_TICK_SECONDS=30
# RECOVERY_MAX_ATTEMPTS=3
# RECOVERY_OPERATION_MAX_AGE_HOURS=72
# RECOVERY_RETRY_BACKOFF_SECONDS=300

# ── Webhooks ──────────────────────────────────────────────────────────────────
# RAZORPAY_WEBHOOK_SECRET=
# DEFAULT_TEST_PAYMENT_ACCOUNT_ID=

# ── Detection ─────────────────────────────────────────────────────────────────
# DETECTION_WINDOW_HOURS=24

# ── Demo Mode (Phase 11) ──────────────────────────────────────────────────────
# DEMO_MODE_ENABLED=false

# ── Frontend ──────────────────────────────────────────────────────────────────
# NEXT_PUBLIC_API_URL=http://127.0.0.1:4000
# NEXT_PUBLIC_APP_URL=http://localhost:3000
