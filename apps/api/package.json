{
  "name": "@recoveryos/api",
  "version": "0.1.0",
  "private": true,
  "description": "RecoveryOS API foundation: health/readiness, structured logging, centralized errors, Prisma persistence.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@prisma/client": "6.12.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.1",
    "pino": "^10.3.1",
    "prisma": "6.12.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "eslint": "9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  }
}
